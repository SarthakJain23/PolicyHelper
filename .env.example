# ==============================================================================
# PolicyHelper - Environment Configuration
# ==============================================================================

# Server & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & JWT Auth
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin (Seeded on first migration/startup if no users exist)
FIRST_SUPERUSER_EMAIL=admin@company.internal
FIRST_SUPERUSER_PASSWORD=AdminInitialPass123!
FIRST_SUPERUSER_NAME="System Administrator"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=policyhelper_db
# Async Database URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policyhelper_db

# Document Storage Strategy ("local" or "s3")
STORAGE_TYPE=local
# Local Storage config
LOCAL_STORAGE_DIR=/Users/sarthak/Desktop/Personal/PolicyHelper/data/policies

# S3 / MinIO Storage config (used when STORAGE_TYPE=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopass123
S3_BUCKET_NAME=policies
S3_REGION=us-east-1

# LLM Provider Strategy ("gemini", "openai", or "anthropic")
LLM_PROVIDER=gemini

# Google Gemini API Key & Models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_FAST_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI API Key & Models (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Anthropic API Key & Models (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# RAG & Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=15
RERANK_TOP_K=4
AUTO_TITLE_MESSAGE_THRESHOLD=2
