# ==============================================================================
# PolicyHelper - Environment Configuration
# ==============================================================================

# Server & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & JWT Auth
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin (Seeded on first migration/startup if no users exist)
FIRST_SUPERUSER_EMAIL=admin@company.internal
FIRST_SUPERUSER_PASSWORD=AdminInitialPass123!
FIRST_SUPERUSER_NAME="System Administrator"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=policyhelper_db
# Async Database URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policyhelper_db

# Document Storage Strategy ("local" or "s3")
STORAGE_TYPE=local
# Local Storage config
LOCAL_STORAGE_DIR=/Users/sarthak/Desktop/Personal/PolicyHelper/data/policies

# S3 / MinIO Storage config (used when STORAGE_TYPE=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopass123
S3_BUCKET_NAME=policies
S3_REGION=us-east-1

# RAG & Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=15
RERANK_TOP_K=4
AUTO_TITLE_MESSAGE_THRESHOLD=2
